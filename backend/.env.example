SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
# Optional; authentication can validate tokens through Supabase.
SUPABASE_JWT_SECRET=
# Optional legacy direct SQL setting; the API uses Supabase REST.
DATABASE_URL=

# JSON array of exact frontend origins, without URL paths or wildcards.
CORS_ORIGINS=["http://localhost:3000","https://nikitha.space","https://www.nikitha.space"]

S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_BUCKET=your-existing-bucket
S3_REGION=your-bucket-region
S3_ENDPOINT=

# Local: http://localhost:6333 with an empty API key.
# Production: the HTTPS cluster URL and API key from Qdrant Cloud.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=nexusrag_chunks
QDRANT_TIMEOUT=30

GROQ_API_KEY=your-groq-api-key
LLM_MODEL=openai/gpt-oss-20b
LLM_INPUT_TOKEN_BUDGET=5000

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_PROFILE=bge-small-onnx-v1
EMBEDDING_THREADS=1
EMBEDDING_BATCH_SIZE=1
# Local only. Docker sets its own cache and offline mode;
# do not override these two variables on Render.
EMBEDDING_CACHE_DIR=/tmp/fastembed
EMBEDDING_LOCAL_FILES_ONLY=false

CHUNK_SIZE=1024
CHUNK_OVERLAP=128
TOP_K_RESULTS=5
